{
  "name": "tboard",
  "version": "0.2.0",
  "description": "A local-first Kanban board for your git repos — one board per repo, cards tied to real branches, with a built-in MCP server so agents can drive it too.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build && node scripts/buildMcp.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "mcp:dev": "tsx src/mcp/stdio.ts",
    "mcp:build": "node scripts/buildMcp.mjs",
    "mcp:smoke": "tsx scripts/mcpSmoke.ts",
    "server:dev": "tsx src/server/index.ts",
    "server:build": "node scripts/buildServer.mjs",
    "server:hash-password": "tsx scripts/hashPassword.mjs",
    "server:push": "tsx scripts/pushToRemote.mjs",
    "db:embed": "node scripts/generateEmbeddedMigrations.mjs",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "kanban",
    "board",
    "git",
    "electron",
    "react",
    "typescript",
    "sqlite",
    "mcp",
    "model-context-protocol",
    "local-first",
    "project-management"
  ],
  "author": {
    "name": "tomol"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/tomolom/tBoard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomolom/tBoard.git"
  },
  "bugs": {
    "url": "https://github.com/tomolom/tBoard/issues"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@swc/core": "^1.16.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
