# Copy to deploy/deploy.env (gitignored) and fill in. NEVER commit the real file.
# Used only to drive an assisted SSH deploy of the tBoard web server.

# --- Your VPS (SSH) ---
VPS_HOST=203.0.113.10          # your server's public IP or hostname
VPS_USER=root                  # SSH user (root, or a sudo-capable user)
VPS_SSH_KEY=                   # OPTIONAL path to a private key; blank = your default ssh key/agent

# --- tBoard ---
DOMAIN=board.example.com       # the subdomain whose DNS A record points at VPS_HOST
TBOARD_PASSWORD=               # the board login password you want (used once to make a hash; not sent anywhere else)
