# Copy to `.env` and fill in. Never commit `.env`.

# Your domain (the DNS A record must point at this host).
DOMAIN=board.example.com

# The exact public origin, used for strict Origin/CSRF checks. Must match DOMAIN.
TBOARD_PUBLIC_ORIGIN=https://board.example.com

# The scrypt password hash from: npm run server:hash-password -- "your passphrase"
# (Generate it locally or in the build container; paste the whole scrypt:... value.)
TBOARD_AUTH_PASSWORD_HASH=scrypt:32768:8:1:REPLACE_ME:REPLACE_ME
